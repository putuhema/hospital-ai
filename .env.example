# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Unified AI model configuration (works with any OpenAI-compatible provider or Anthropic).
# Examples:
#   OpenAI:      LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini               LLM_BASE_URL=                              LLM_API_KEY=sk-...
#   OpenRouter:  LLM_PROVIDER=openrouter  LLM_MODEL=google/gemini-2.5-flash   LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
#   Groq:        LLM_PROVIDER=groq        LLM_MODEL=llama-3.3-70b-versatile   LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_API_KEY=gsk_...
#   Z.ai (GLM):  LLM_PROVIDER=zai         LLM_MODEL=glm-5                     LLM_BASE_URL=https://api.z.ai/api/paas/v4/ LLM_API_KEY=...
#   Anthropic:   LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-4-5         LLM_BASE_URL=                              LLM_API_KEY=sk-ant-...
#   Ollama:      LLM_PROVIDER=ollama      LLM_MODEL=qwen2.5:14b               LLM_BASE_URL=http://localhost:11434/v1     LLM_API_KEY=ollama
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Optional separate vision model for reading uploaded leaflet images (defaults to LLM_MODEL, or glm-4.6v on Z.ai)
LLM_VISION_MODEL=

# Legacy provider env vars (still supported if LLM_* above are left empty)
ZAI_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
# Leaflet and brochure images (editor → Hospital info → Brosur & leaflet): a public
# Vercel Blob store connected to the project sets it; `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
# The model that reads a leaflet's text on Z.ai, when there is no ANTHROPIC_API_KEY (default glm-4.6v)
ZAI_VISION_MODEL=
# The hospital's time zone, when the server's clock is in another, e.g. Asia/Makassar
HOSPITAL_TIME_ZONE=
# Required in production: lets the server count chat questions in Convex. Set
# the same value on the Convex deployment: npx convex env set CHAT_LIMIT_SECRET …
CHAT_LIMIT_SECRET=
# Live queue and beds from SIMRS Khanza: nothing to set here. The bridge (bridge/README.md) holds
# SIMRS_BRIDGE_SECRET, set on the Convex deployment too: npx convex env set SIMRS_BRIDGE_SECRET …
