# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# The chat assistant: GLM on Z.ai (used when set), or Claude. Without either
# the chat uses its built-in replies.
ZAI_API_KEY=
ANTHROPIC_API_KEY=
# Another model of that provider (defaults: glm-5, claude-opus-5-5)
ASSISTANT_MODEL=
# The hospital's time zone, when the server's clock is in another, e.g. Asia/Makassar
HOSPITAL_TIME_ZONE=
# Required in production: lets the server count chat questions in Convex. Set
# the same value on the Convex deployment: npx convex env set CHAT_LIMIT_SECRET …
CHAT_LIMIT_SECRET=
