# --- SIMRS Khanza database (MySQL / MariaDB) ---
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306
KHANZA_DB_NAME=sik
# A SELECT-only user; the bridge refuses one that can change data. See README.md.
KHANZA_DB_READ_USER=
KHANZA_DB_READ_PASS=

# --- The visitor app ---
# The Convex deployment's site address (PUBLIC_CONVEX_SITE_URL in the app's .env.local).
CONVEX_SITE_URL=https://example-123.convex.site
# The same value as on the deployment: npx convex env set SIMRS_BRIDGE_SECRET …
SIMRS_BRIDGE_SECRET=
# Only when the deployment holds several hospitals: the one at /m/<slug>.
HOSPITAL_SLUG=

# Seconds between reads of SIMRS (default 15).
BRIDGE_INTERVAL_SECONDS=15
# For trying it on a copy of the database: read this day instead of today (YYYY-MM-DD).
BRIDGE_DATE=
